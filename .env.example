# Copy to `.env` and fill in. python-dotenv loads this automatically.

# SimSat (https://github.com/DPhi-Space/SimSat)
# - The `sim` container needs MAPBOX_ACCESS_TOKEN (any non-empty value) to boot
#   even if you only use the Sentinel-2 endpoints. Set it in your shell before
#   `docker compose up -d` in the SimSat checkout.
# - After boot, start the orbit via the dashboard UI or:
#     curl -X POST http://localhost:8000/api/commands/ \
#         -H "Content-Type: application/json" -d '{"command":"start"}'
SIMSAT_BASE_URL=http://localhost:9005

# JEPA encoder (Sentinel-2 I-JEPA ViT-L/8)
# Default behaviour: auto-download from HuggingFace (Siddharth63/forestWHY-JEPA-vitl).
# To use a local copy instead, set JEPA_CKPT to its absolute path and leave
# JEPA_HF_* unset.
JEPA_CKPT=
JEPA_HF_REPO=Siddharth63/forestWHY-JEPA-vitl
JEPA_HF_FILENAME=s2_ijepa_gee_vitl_full_encoder_final.pt

# Fine-tuned VLM
VLM_BASE_URL=http://localhost:8000/v1
VLM_MODEL=Siddharth63/LFM2.5-forestWHY

# llama.cpp / GGUF backend
LLAMA_BASE_URL=http://localhost:8080/v1
LLAMA_PORT=8080

# Auto-pulled GGUF for the laptop end-to-end smoke test
# (predict.py --smoke-test --with-gguf)
GGUF_HF_REPO=Siddharth63/LFM2.5-forestWHY-GGUF
GGUF_QUANT=Q8_0
GGUF_MMPROJ_FILENAME=LFM2.5-forestWHY.BF16-mmproj.gguf

# Annotator (evaluation only)
ANTHROPIC_API_KEY=

# Optional: Mapbox token for SimSat high-res endpoint and dashboard tiles
MAPBOX_ACCESS_TOKEN=

# HuggingFace cache directory (optional; default is ~/.cache/huggingface)
HF_HOME=
